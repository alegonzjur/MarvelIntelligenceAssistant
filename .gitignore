*.py[cod]
*.egg-info/
.eggs/
.Python
env/
venv/
.venv/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Datos generados (NO subir a git, sí versionar con DVC si lo añades) ---
data/processed/*.db
data/vectorstore/
!data/vectorstore/.gitkeep

# --- Datos crudos: opcional ---
